<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: prevent silent resurrection of private app files, device IDs
     or encrypted OneDrive tokens from system backups or device transfers.
     Explicitly restoring from a JSON or OneDrive after review is supported. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
